{
  "name": "markdown-notebook",
  "version": "1.1.0",
  "description": "A modern minimalistic Markdown note-taking desktop application.",
  "main": "./out/main.js",
  "author": "Stephen Rector",
  "license": "MIT",
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "start": "tsc && electron .",
    "pack": "tsc && electron-builder",
    "pretest:e2e": "tsc",
    "test:e2e": "playwright test",
    "test:renderer": "node tests/renderer/smoke.spec.mjs darwin && node tests/renderer/smoke.spec.mjs win32",
    "test:ui-audit": "node tests/renderer/ui-audit.mjs",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "pack:win": "tsc && electron-builder --win",
    "pack:mac": "tsc && electron-builder --mac"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.11.24",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.2"
  },
  "build": {
    "appId": "com.stephenrector.markdownnotebook",
    "productName": "Markdown Notebook",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "renderer/**/*",
      "build/icon.png",
      "!renderer/**/*.map"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  }
}
