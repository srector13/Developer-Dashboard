{
  "name": "markdown-notebook",
  "version": "1.0.0",
  "description": "A modern minimalistic Markdown note-taking desktop application.",
  "main": "./out/main.js",
  "author": "Stephen Rector",
  "license": "MIT",
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "start": "tsc && electron .",
    "pack": "electron-builder",
    "pretest:e2e": "tsc",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.11.24",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.2"
  },
  "build": {
    "appId": "com.stephenrector.markdownnotebook",
    "productName": "Markdown Notebook",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  }
}
