{
  "name": "markdown-notebook",
  "displayName": "Markdown Notebook",
  "description": "A Markdown note-taking workspace for VS Code: notebook view, templates, paste-to-import, and document conversion. A OneNote-style companion that works with GitHub Copilot.",
  "version": "0.8.21",
  "publisher": "stephen-rector",
  "author": {
    "name": "Stephen Rector"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "markdown",
    "notes",
    "notebook",
    "note-taking",
    "onenote",
    "pandoc",
    "copilot"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "markdownNotebook.editor.insertMenu",
        "label": "Markdown Format",
        "icon": "$(pencil)"
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/github-markdown.css"
    ],
    "markdown.previewScripts": [
      "./media/theme-bootstrap.js",
      "./media/mermaid.min.js",
      "./media/mermaid-preview.js"
    ],
    "commands": [
      {
        "command": "pandocToMarkdown.convert",
        "title": "Convert to Markdown (Pandoc)",
        "category": "Pandoc"
      },
      {
        "command": "markdownNotebook.newPage",
        "title": "New Page",
        "category": "Notebook",
        "icon": "$(new-file)"
      },
      {
        "command": "markdownNotebook.toggleTaskAtLine",
        "title": "Toggle Task Checkbox",
        "category": "Notebook"
      },
      {
        "command": "markdownNotebook.toggleMermaidOrientationAtLine",
        "title": "Toggle Mermaid Orientation At Line",
        "category": "Notebook"
      },
      {
        "command": "markdownNotebook.newSection",
        "title": "New Section",
        "category": "Notebook",
        "icon": "$(new-folder)"
      },
      {
        "command": "markdownNotebook.refresh",
        "title": "Refresh",
        "category": "Notebook",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownNotebook.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Notebook"
      },
      {
        "command": "markdownNotebook.newFromTemplate",
        "title": "New from Template",
        "category": "Notebook",
        "icon": "$(file-add)"
      },
      {
        "command": "markdownNotebook.renamePage",
        "title": "Rename (update links)",
        "category": "Notebook",
        "icon": "$(edit)"
      },
      {
        "command": "markdownNotebook.renameSection",
        "title": "Rename Section",
        "category": "Notebook",
        "icon": "$(edit)"
      },
      {
        "command": "markdownNotebook.moveUp",
        "title": "Move Up",
        "category": "Notebook",
        "icon": "$(arrow-up)"
      },
      {
        "command": "markdownNotebook.moveDown",
        "title": "Move Down",
        "category": "Notebook",
        "icon": "$(arrow-down)"
      },
      {
        "command": "markdownNotebook.importFromClipboard",
        "title": "Import Clipboard as Note",
        "category": "Notebook",
        "icon": "$(clippy)"
      },

      {
        "command": "markdownNotebook.importDocument",
        "title": "Import Document…",
        "category": "Notebook",
        "icon": "$(desktop-download)"
      },
      {
        "command": "markdownNotebook.exportPdf",
        "title": "Export to PDF…",
        "category": "Notebook",
        "icon": "$(file-pdf)"
      },
      {
        "command": "markdownNotebook.outline.goToLine",
        "title": "Go to Heading",
        "category": "Notebook"
      },
      {
        "command": "markdownNotebook.filterByTag",
        "title": "Filter by Tag",
        "category": "Notebook",
        "icon": "$(filter)"
      },
      {
        "command": "markdownNotebook.openSettings",
        "title": "Notebook Settings",
        "category": "Notebook",
        "icon": "$(gear)"
      },
      {
        "command": "markdownNotebook.addNewMenu",
        "title": "New Page or Section...",
        "category": "Notebook",
        "icon": "$(add)"
      },
      {
        "command": "markdownNotebook.importMenu",
        "title": "Import Note...",
        "category": "Notebook",
        "icon": "$(cloud-download)"
      },
      {
        "command": "markdownNotebook.newDailyNote",
        "title": "New Daily Note",
        "category": "Notebook",
        "icon": "$(calendar)"
      },
      {
        "command": "markdownNotebook.openTasksDashboard",
        "title": "Open Tasks Dashboard",
        "category": "Notebook",
        "icon": "$(checklist)"
      },
      {
        "command": "markdownNotebook.insert.toggleTask",
        "title": "Check/Uncheck Task",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.outline.previewScrolled",
        "title": "Sync Outline to Scroll Position",
        "category": "Notebook"
      },
      {
        "command": "markdownNotebook.deleteNode",
        "title": "Delete",
        "category": "Notebook",
        "icon": "$(trash)"
      },
      {
        "command": "markdownNotebook.outline.expandAll",
        "title": "Expand All",
        "category": "Notebook",
        "icon": "$(chevron-down)"
      },
      {
        "command": "markdownNotebook.outline.refresh",
        "title": "Refresh Outline",
        "category": "Notebook",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownNotebook.outline.copyToc",
        "title": "Copy Table of Contents",
        "category": "Notebook",
        "icon": "$(copy)"
      },
      {
        "command": "markdownNotebook.collapseAll",
        "title": "Collapse All",
        "category": "Notebook",
        "icon": "$(chevron-up)"
      },
      {
        "command": "markdownNotebook.outline.collapseAll",
        "title": "Collapse All",
        "category": "Notebook",
        "icon": "$(chevron-up)"
      },
      {
        "command": "markdownNotebook.insert.bold",
        "title": "Bold",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.italic",
        "title": "Italic",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.h1",
        "title": "Heading 1",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.h2",
        "title": "Heading 2",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.h3",
        "title": "Heading 3",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.bulletList",
        "title": "Bulleted List",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.numberedList",
        "title": "Numbered List",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.taskList",
        "title": "Task List Item",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.codeBlock",
        "title": "Code Block",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.table",
        "title": "Table",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.toggleMermaidOrientation",
        "title": "Toggle Mermaid Orientation",
        "category": "Format",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "markdownNotebook.insert.separator",
        "title": "Insert Separator",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.insert.formatMenu",
        "title": "Markdown Format Selector",
        "category": "Format"
      },
      {
        "command": "markdownNotebook.openSource",
        "title": "Show Source (Markdown)",
        "category": "Format",
        "icon": "$(code)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownNotebook",
          "title": "Notebook",
          "icon": "resources/notebook.svg"
        }
      ]
    },
    "views": {
      "markdownNotebook": [
        {
          "id": "markdownNotebook.view",
          "name": "Notebook",
          "icon": "resources/notebook.svg"
        },
        {
          "id": "markdownNotebook.outline",
          "name": "Outline",
          "icon": "resources/page.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "markdownNotebook.view",
        "contents": "No folder is open.\nOpen a folder to use it as your notebook.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "markdownNotebook.view",
        "contents": "This notebook has no pages yet.\n[New Page](command:markdownNotebook.newPage)",
        "when": "workbenchState != empty"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pandocToMarkdown.convert",
          "when": "resourceExtname =~ /^\\.(docx|pptx|xlsx|odt|rtf|epub|html?)$/i",
          "group": "7_modification"
        },
        {
          "command": "markdownNotebook.exportPdf",
          "when": "resourceExtname == .md",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "pandocToMarkdown.convert",
          "when": "resourceExtname =~ /^\\.(docx|pptx|xlsx|odt|rtf|epub|html?)$/i"
        }
      ],
      "view/title": [
        {
          "command": "markdownNotebook.addNewMenu",
          "when": "view == markdownNotebook.view",
          "group": "navigation@1"
        },
        {
          "command": "markdownNotebook.importMenu",
          "when": "view == markdownNotebook.view",
          "group": "navigation@2"
        },
        {
          "command": "markdownNotebook.filterByTag",
          "when": "view == markdownNotebook.view",
          "group": "navigation@3"
        },
        {
          "command": "markdownNotebook.openTasksDashboard",
          "when": "view == markdownNotebook.view",
          "group": "navigation@4"
        },
        {
          "command": "markdownNotebook.refresh",
          "when": "view == markdownNotebook.view",
          "group": "navigation@5"
        },
        {
          "command": "markdownNotebook.openSettings",
          "when": "view == markdownNotebook.view",
          "group": "navigation@6"
        },
        {
          "command": "markdownNotebook.collapseAll",
          "when": "view == markdownNotebook.view",
          "group": "navigation@10"
        },
        {
          "command": "markdownNotebook.outline.collapseAll",
          "when": "view == markdownNotebook.outline",
          "group": "navigation@10"
        },
        {
          "command": "markdownNotebook.outline.expandAll",
          "when": "view == markdownNotebook.outline",
          "group": "navigation@11"
        },
        {
          "command": "markdownNotebook.outline.refresh",
          "when": "view == markdownNotebook.outline",
          "group": "navigation@12"
        },
        {
          "command": "markdownNotebook.outline.copyToc",
          "when": "view == markdownNotebook.outline",
          "group": "navigation@13"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownNotebook.newPage",
          "when": "view == markdownNotebook.view && viewItem == section",
          "group": "inline"
        },
        {
          "command": "markdownNotebook.newSection",
          "when": "view == markdownNotebook.view && viewItem == section",
          "group": "1_new@1"
        },
        {
          "command": "markdownNotebook.newFromTemplate",
          "when": "view == markdownNotebook.view && viewItem == section",
          "group": "1_new@2"
        },
        {
          "command": "markdownNotebook.renamePage",
          "when": "view == markdownNotebook.view && viewItem =~ /Page$/",
          "group": "inline@1"
        },
        {
          "command": "markdownNotebook.renameSection",
          "when": "view == markdownNotebook.view && viewItem == section",
          "group": "inline@1"
        },
        {
          "command": "markdownNotebook.exportPdf",
          "when": "view == markdownNotebook.view && viewItem =~ /Page$/",
          "group": "inline@2"
        },
        {
          "command": "markdownNotebook.moveUp",
          "when": "view == markdownNotebook.view && viewItem =~ /Page$/",
          "group": "2_order@1"
        },
        {
          "command": "markdownNotebook.moveDown",
          "when": "view == markdownNotebook.view && viewItem =~ /Page$/",
          "group": "2_order@2"
        },
        {
          "command": "markdownNotebook.renamePage",
          "when": "view == markdownNotebook.view && viewItem =~ /Page$/",
          "group": "7_modification@1"
        },
        {
          "command": "markdownNotebook.renameSection",
          "when": "view == markdownNotebook.view && viewItem == section",
          "group": "7_modification@1"
        },
        {
          "command": "markdownNotebook.exportPdf",
          "when": "view == markdownNotebook.view && viewItem =~ /Page$/",
          "group": "7_modification@2"
        },
        {
          "command": "markdownNotebook.deleteNode",
          "when": "view == markdownNotebook.view",
          "group": "7_modification@3"
        },
        {
          "command": "markdownNotebook.revealInExplorer",
          "when": "view == markdownNotebook.view",
          "group": "9_reveal"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownNotebook.exportPdf",
          "when": "resourceExtname == .md",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "markdownNotebook.openSource",
          "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@1"
        },
        {
          "submenu": "markdownNotebook.editor.insertMenu",
          "when": "resourceExtname == .md && editorLangId == markdown",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "submenu": "markdownNotebook.editor.insertMenu",
          "when": "editorHasSelection && resourceExtname == .md && editorLangId == markdown",
          "group": "1_modification"
        },
        {
          "command": "markdownNotebook.insert.toggleTask",
          "when": "resourceExtname == .md && editorLangId == markdown",
          "group": "1_modification@10"
        }
      ],
      "markdownNotebook.editor.insertMenu": [
        {
          "command": "markdownNotebook.insert.bold",
          "group": "1_inline@1"
        },
        {
          "command": "markdownNotebook.insert.italic",
          "group": "1_inline@2"
        },
        {
          "command": "markdownNotebook.insert.h1",
          "group": "2_headings@1"
        },
        {
          "command": "markdownNotebook.insert.h2",
          "group": "2_headings@2"
        },
        {
          "command": "markdownNotebook.insert.h3",
          "group": "2_headings@3"
        },
        {
          "command": "markdownNotebook.insert.bulletList",
          "group": "3_lists@1"
        },
        {
          "command": "markdownNotebook.insert.numberedList",
          "group": "3_lists@2"
        },
        {
          "command": "markdownNotebook.insert.taskList",
          "group": "3_lists@3"
        },
        {
          "command": "markdownNotebook.insert.toggleTask",
          "group": "3_lists@4"
        },
        {
          "command": "markdownNotebook.insert.codeBlock",
          "group": "4_blocks@1"
        },
        {
          "command": "markdownNotebook.insert.table",
          "group": "4_blocks@2"
        },
        {
          "command": "markdownNotebook.insert.toggleMermaidOrientation",
          "group": "4_blocks@3",
          "when": "resourceExtname == .md && editorLangId == markdown"
        },
        {
          "command": "markdownNotebook.insert.separator",
          "group": "4_blocks@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownNotebook.insert.formatMenu",
        "key": "alt+shift+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.bold",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.italic",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.h1",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.h2",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.h3",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.bulletList",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.numberedList",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.taskList",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.toggleTask",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.insert.separator",
        "key": "ctrl+alt+-",
        "mac": "cmd+alt+-",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownNotebook.openSource",
        "key": "alt+shift+s",
        "mac": "cmd+alt+s",
        "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
      }
    ],
    "configuration": {
      "title": "Markdown Notebook",
      "properties": {
        "pandocToMarkdown.pandocPath": {
          "type": "string",
          "default": "pandoc",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `pandoc` executable. Leave as `pandoc` if it is on your PATH, or set an absolute path (e.g. `/opt/homebrew/bin/pandoc`)."
        },
        "pandocToMarkdown.deleteOriginal": {
          "type": "boolean",
          "default": true,
          "description": "After a successful conversion, remove the original document."
        },
        "pandocToMarkdown.useTrash": {
          "type": "boolean",
          "default": true,
          "description": "When removing the original, move it to the OS trash (recoverable) instead of deleting it permanently."
        },
        "pandocToMarkdown.confirmDelete": {
          "type": "boolean",
          "default": false,
          "description": "Ask for confirmation once before removing originals."
        },
        "pandocToMarkdown.extractMedia": {
          "type": "boolean",
          "default": true,
          "description": "Extract embedded images (from Word/PowerPoint) into a sibling folder named `<file>_media` and link them in the Markdown."
        },
        "pandocToMarkdown.markdownVariant": {
          "type": "string",
          "default": "gfm",
          "enum": [
            "gfm",
            "markdown",
            "markdown_strict",
            "commonmark",
            "markdown_mmd",
            "markdown_phpextra"
          ],
          "markdownDescription": "Pandoc Markdown output flavor. `gfm` (GitHub-Flavored Markdown) renders tables well and is a good default for spreadsheets."
        },
        "pandocToMarkdown.wrap": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "auto",
            "preserve"
          ],
          "markdownDescription": "Passed to pandoc as `--wrap`. `none` keeps each paragraph on one line (easiest to edit/diff)."
        },
        "pandocToMarkdown.standalone": {
          "type": "boolean",
          "default": false,
          "description": "Produce a standalone document with a YAML metadata header (title, author, etc.) instead of just the body."
        },
        "pandocToMarkdown.addFrontmatter": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After converting, prepend Notebook frontmatter (`title`, `created`, `author`, `tags`) so the result appears as a titled note in the Notebook view. The title is taken from the document's first heading, or the filename. Ignored when `#standalone#` is on (pandoc writes its own metadata then)."
        },
        "pandocToMarkdown.openAfterConvert": {
          "type": "boolean",
          "default": true,
          "description": "Open the converted Markdown file after conversion."
        },
        "pandocToMarkdown.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "Extra command-line arguments appended to every pandoc invocation (e.g. `[\"--markdown-headings=atx\"]`)."
        },
        "markdownNotebook.alwaysShowPreview": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Always open Markdown notes in the Preview pane instead of the raw text editor when selected in the sidebar."
        },
        "markdownNotebook.defaultPageWidth": {
          "type": "string",
          "enum": [
            "standard",
            "wide",
            "full"
          ],
          "default": "standard",
          "markdownDescription": "Default layout width for the Markdown Preview page. Standard is `980px` (best scannability), Wide is `1400px` (better for larger monitors), and Full is `100%` width."
        },
        "markdownNotebook.defaultMermaidZoom": {
          "type": "integer",
          "default": 100,
          "minimum": 40,
          "maximum": 300,
          "markdownDescription": "Default zoom percentage level for Mermaid flowcharts and diagrams in the preview (between 40% and 300%)."
        },
        "markdownNotebook.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder to treat as the notebook root. Leave empty to use the first workspace folder, or set a subfolder (e.g. `notes`) or an absolute path."
        },
        "markdownNotebook.ignoreFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "_media",
            "attachments",
            "templates",
            "node_modules",
            ".git",
            ".vscode"
          ],
          "description": "Folder names hidden from the Notebook view (case-insensitive). Dot-folders are always hidden."
        },
        "markdownNotebook.dailyNotePattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "default": [
            "^\\d{4}-\\d{2}-\\d{2}",
            "\\d{4}-\\d{2}-\\d{2}",
            "\\d{4}_\\d{2}_\\d{2}",
            "\\d{1,2}-\\d{1,2}-\\d{2,4}",
            "\\d{1,2}_\\d{1,2}_\\d{2,4}"
          ],
          "markdownDescription": "Regex pattern or list of patterns matched against a file name to detect a daily note. Matching notes get a calendar icon, friendly dates, and newest-first sorting."
        },
        "markdownNotebook.templatesFolder": {
          "type": "string",
          "default": "templates",
          "markdownDescription": "Folder (relative to the notebook root, or absolute) that holds `.md` templates for **New from Template**. Templates support `{{title}}`, `{{date}}`, `{{time}}`, `{{datetime}}`, `{{weekday}}`, `{{slug}}`, and a `{{cursor}}` marker."
        },
        "markdownNotebook.author": {
          "type": "string",
          "default": "",
          "markdownDescription": "Author name written to the `author:` frontmatter field of new and imported notes. Leave empty to omit."
        },
        "markdownNotebook.previewTheme": {
          "type": "string",
          "default": "github",
          "enum": [
            "github",
            "github-dark",
            "off"
          ],
          "enumDescriptions": [
            "GitHub theme that follows your VS Code light/dark mode",
            "Force the GitHub Dark theme regardless of VS Code mode",
            "Don't apply the GitHub preview theme"
          ],
          "markdownDescription": "Styling applied to the built-in Markdown preview and to PDF/HTML exports. `github` follows your editor's light/dark mode."
        },
        "markdownNotebook.exportTheme": {
          "type": "string",
          "default": "github",
          "enum": [
            "github",
            "github-dark",
            "off"
          ],
          "enumDescriptions": [
            "GitHub Light theme (standard light background, dark text)",
            "GitHub Dark theme (dark background, light text)",
            "Don't apply any custom theme"
          ],
          "markdownDescription": "Styling applied to PDF/HTML exports. `github` uses the standard light mode GitHub theme, which is recommended for professional printed documents."
        },
        "markdownNotebook.pdfEngine": {
          "type": "string",
          "default": "chrome",
          "enum": [
            "chrome",
            "auto",
            "weasyprint",
            "wkhtmltopdf",
            "prince"
          ],
          "markdownDescription": "PDF engine used for export. `chrome` uses a headless Chrome/Chromium browser to export high-fidelity PDFs (automatically renders Mermaid and preserves CSS). `auto` tries the lightweight Pandoc engines in order (WeasyPrint → wkhtmltopdf → Prince) and uses the first one installed. Or pick one of them explicitly."
        },
        "markdownNotebook.mermaidCliPath": {
          "type": "string",
          "default": "mmdc",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the mermaid-cli (`mmdc`) executable, used to render Mermaid diagrams when exporting to PDF/HTML. Install with `npm i -g @mermaid-js/mermaid-cli`. The live preview renders Mermaid without this."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
