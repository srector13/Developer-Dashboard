{
  "name": "dev-suite",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "A suite of portable Windows developer tools that share a design language, a data model and a discovery registry — Dev Hub and Log Viewer, with Markdown Notebook to follow.",
  "author": "Stephen Rector",
  "license": "MIT",
  "scripts": {
    "dev:hub": "cargo tauri dev --config apps/dev-hub/src-tauri/tauri.conf.json",
    "dev:logs": "cargo tauri dev --config apps/log-viewer/src-tauri/tauri.conf.json",
    "build": "cargo build --release --workspace",
    "build:hub": "cargo build --release -p dev-hub",
    "build:logs": "cargo build --release -p log-viewer",
    "check": "cargo check --workspace --all-targets",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt": "cargo fmt --all",
    "test:rust": "cargo test --workspace",
    "test:renderer": "npm run test:renderer:hub && npm run test:renderer:logs",
    "test:renderer:hub": "node apps/dev-hub/tests/renderer/launcher.spec.mjs && node apps/dev-hub/tests/renderer/dashboard.spec.mjs && node apps/dev-hub/tests/renderer/settings.spec.mjs && node apps/dev-hub/tests/renderer/setup.spec.mjs",
    "test:renderer:logs": "node apps/log-viewer/tests/renderer/viewer.spec.mjs",
    "ui:sync": "node scripts/sync-ui.mjs",
    "ui:check": "node scripts/sync-ui.mjs --check",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@playwright/test": "^1.61.1"
  }
}
